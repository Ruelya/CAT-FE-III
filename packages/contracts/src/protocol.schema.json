{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProtocolCatalog",
  "type": "object",
  "properties": {
    "confirm_segment_params": {
      "$ref": "#/$defs/ConfirmSegmentParams"
    },
    "confirm_segment_result": {
      "$ref": "#/$defs/ConfirmSegmentResult"
    },
    "create_project_params": {
      "$ref": "#/$defs/CreateProjectParams"
    },
    "document_id_params": {
      "$ref": "#/$defs/DocumentIdParams"
    },
    "exact_lookup_params": {
      "$ref": "#/$defs/ExactLookupParams"
    },
    "exact_lookup_result": {
      "$ref": "#/$defs/ExactLookupResult"
    },
    "export_docx_params": {
      "$ref": "#/$defs/ExportDocxParams"
    },
    "export_docx_result": {
      "$ref": "#/$defs/ExportDocxResult"
    },
    "import_docx_params": {
      "$ref": "#/$defs/ImportDocxParams"
    },
    "initialize_params": {
      "$ref": "#/$defs/InitializeParams"
    },
    "initialize_result": {
      "$ref": "#/$defs/InitializeResult"
    },
    "list_qa_params": {
      "$ref": "#/$defs/ListQaParams"
    },
    "methods": {
      "$ref": "#/$defs/RpcMethodCatalog"
    },
    "project_id_params": {
      "$ref": "#/$defs/ProjectIdParams"
    },
    "project_snapshot": {
      "$ref": "#/$defs/ProjectSnapshot"
    },
    "qa_list_result": {
      "$ref": "#/$defs/QaListResult"
    },
    "rpc_error": {
      "$ref": "#/$defs/RpcError"
    },
    "segment_list_params": {
      "$ref": "#/$defs/SegmentListParams"
    },
    "segment_page": {
      "$ref": "#/$defs/SegmentPage"
    },
    "update_target_params": {
      "$ref": "#/$defs/UpdateTargetParams"
    }
  },
  "required": [
    "methods",
    "initialize_params",
    "initialize_result",
    "create_project_params",
    "project_id_params",
    "import_docx_params",
    "document_id_params",
    "segment_list_params",
    "update_target_params",
    "confirm_segment_params",
    "exact_lookup_params",
    "list_qa_params",
    "export_docx_params",
    "project_snapshot",
    "segment_page",
    "confirm_segment_result",
    "exact_lookup_result",
    "qa_list_result",
    "export_docx_result",
    "rpc_error"
  ],
  "$defs": {
    "ClientInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "ConfirmSegmentParams": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "segmentId": {
          "type": "string"
        }
      },
      "required": [
        "segmentId",
        "expectedRevision"
      ]
    },
    "ConfirmSegmentResult": {
      "type": "object",
      "properties": {
        "counts": {
          "$ref": "#/$defs/SegmentCounts"
        },
        "qaIssues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QaIssue"
          }
        },
        "segment": {
          "$ref": "#/$defs/Segment"
        },
        "tmEntry": {
          "$ref": "#/$defs/TmEntry"
        }
      },
      "required": [
        "segment",
        "counts",
        "tmEntry",
        "qaIssues"
      ]
    },
    "CreateProjectParams": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sourceLocale": {
          "type": "string"
        },
        "targetLocale": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "sourceLocale",
        "targetLocale",
        "domain"
      ]
    },
    "Document": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "importedAtMs": {
          "type": "integer",
          "format": "int64"
        },
        "name": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "segmentCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sourceSha256": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "projectId",
        "name",
        "format",
        "sourceSha256",
        "segmentCount",
        "importedAtMs"
      ]
    },
    "DocumentIdParams": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string"
        }
      },
      "required": [
        "documentId"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "not_found",
        "conflict",
        "invalid_state",
        "unsupported_document",
        "storage_error",
        "export_error",
        "internal_error"
      ]
    },
    "ExactLookupParams": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "sourceText": {
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "sourceText"
      ]
    },
    "ExactLookupResult": {
      "type": "object",
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TmEntry"
          }
        }
      },
      "required": [
        "matches"
      ]
    },
    "ExportDocxParams": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string"
        },
        "outputPath": {
          "type": "string"
        }
      },
      "required": [
        "documentId",
        "outputPath"
      ]
    },
    "ExportDocxResult": {
      "type": "object",
      "properties": {
        "outputPath": {
          "type": "string"
        },
        "translatedSegments": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "outputPath",
        "translatedSegments"
      ]
    },
    "ImportDocxParams": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "sourcePath": {
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "sourcePath"
      ]
    },
    "InitializeParams": {
      "type": "object",
      "properties": {
        "client": {
          "$ref": "#/$defs/ClientInfo"
        },
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "protocolVersion",
        "client"
      ]
    },
    "InitializeResult": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engineVersion": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "protocolVersion",
        "engineVersion",
        "capabilities"
      ]
    },
    "ListQaParams": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string"
        },
        "includeResolved": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "documentId"
      ]
    },
    "MethodContract": {
      "type": "object",
      "properties": {
        "params": {
          "$ref": "#/$defs/InitializeParams"
        },
        "result": {
          "$ref": "#/$defs/InitializeResult"
        }
      },
      "required": [
        "params",
        "result"
      ]
    },
    "MethodContract10": {
      "type": "object",
      "properties": {
        "params": {
          "$ref": "#/$defs/ListQaParams"
        },
        "result": {
          "$ref": "#/$defs/QaListResult"
        }
      },
      "required": [
        "params",
        "result"
      ]
    },
    "MethodContract11": {
      "type": "object",
      "properties": {
        "params": {
          "$ref": "#/$defs/ExportDocxParams"
        },
        "result": {
          "$ref": "#/$defs/ExportDocxResult"
        }
      },
      "required": [
        "params",
        "result"
      ]
    },
    "MethodContract2": {
      "type": "object",
      "properties": {
        "params": {
          "$ref": "#/$defs/CreateProjectParams"
        },
        "result": {
          "$ref": "#/$defs/Project"
        }
      },
      "required": [
        "params",
        "result"
      ]
    },
    "MethodContract3": {
      "type": "object",
      "properties": {
        "params": {
          "$ref": "#/$defs/ProjectIdParams"
        },
        "result": {
          "$ref": "#/$defs/ProjectSnapshot"
        }
      },
      "required": [
        "params",
        "result"
      ]
    },
    "MethodContract4": {
      "type": "object",
      "properties": {
        "params": {
          "$ref": "#/$defs/ImportDocxParams"
        },
        "result": {
          "$ref": "#/$defs/Document"
        }
      },
      "required": [
        "params",
        "result"
      ]
    },
    "MethodContract5": {
      "type": "object",
      "properties": {
        "params": {
          "$ref": "#/$defs/SegmentListParams"
        },
        "result": {
          "$ref": "#/$defs/SegmentPage"
        }
      },
      "required": [
        "params",
        "result"
      ]
    },
    "MethodContract6": {
      "type": "object",
      "properties": {
        "params": {
          "$ref": "#/$defs/UpdateTargetParams"
        },
        "result": {
          "$ref": "#/$defs/Segment"
        }
      },
      "required": [
        "params",
        "result"
      ]
    },
    "MethodContract7": {
      "type": "object",
      "properties": {
        "params": {
          "$ref": "#/$defs/ConfirmSegmentParams"
        },
        "result": {
          "$ref": "#/$defs/ConfirmSegmentResult"
        }
      },
      "required": [
        "params",
        "result"
      ]
    },
    "MethodContract8": {
      "type": "object",
      "properties": {
        "params": {
          "$ref": "#/$defs/ExactLookupParams"
        },
        "result": {
          "$ref": "#/$defs/ExactLookupResult"
        }
      },
      "required": [
        "params",
        "result"
      ]
    },
    "MethodContract9": {
      "type": "object",
      "properties": {
        "params": {
          "$ref": "#/$defs/DocumentIdParams"
        },
        "result": {
          "$ref": "#/$defs/QaListResult"
        }
      },
      "required": [
        "params",
        "result"
      ]
    },
    "NumberEvidence": {
      "type": "object",
      "properties": {
        "sourceNumbers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targetNumbers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sourceNumbers",
        "targetNumbers"
      ]
    },
    "Project": {
      "type": "object",
      "properties": {
        "createdAtMs": {
          "type": "integer",
          "format": "int64"
        },
        "domain": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sourceLocale": {
          "type": "string"
        },
        "targetLocale": {
          "type": "string"
        },
        "updatedAtMs": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "name",
        "sourceLocale",
        "targetLocale",
        "domain",
        "createdAtMs",
        "updatedAtMs"
      ]
    },
    "ProjectIdParams": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        }
      },
      "required": [
        "projectId"
      ]
    },
    "ProjectSnapshot": {
      "type": "object",
      "properties": {
        "counts": {
          "$ref": "#/$defs/SegmentCounts"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Document"
          }
        },
        "project": {
          "$ref": "#/$defs/Project"
        }
      },
      "required": [
        "project",
        "documents",
        "counts"
      ]
    },
    "QaIssue": {
      "type": "object",
      "properties": {
        "createdAtMs": {
          "type": "integer",
          "format": "int64"
        },
        "evidence": {
          "$ref": "#/$defs/NumberEvidence"
        },
        "fingerprint": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "ruleId": {
          "type": "string"
        },
        "segmentId": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/QaSeverity"
        },
        "status": {
          "$ref": "#/$defs/QaIssueStatus"
        },
        "updatedAtMs": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "segmentId",
        "ruleId",
        "severity",
        "status",
        "message",
        "fingerprint",
        "evidence",
        "createdAtMs",
        "updatedAtMs"
      ]
    },
    "QaIssueStatus": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ]
    },
    "QaListResult": {
      "type": "object",
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QaIssue"
          }
        }
      },
      "required": [
        "issues"
      ]
    },
    "QaSeverity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "RpcError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "data": true,
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "RpcMethodCatalog": {
      "type": "object",
      "properties": {
        "document.exportDocx": {
          "$ref": "#/$defs/MethodContract11"
        },
        "document.importDocx": {
          "$ref": "#/$defs/MethodContract4"
        },
        "engine.initialize": {
          "$ref": "#/$defs/MethodContract"
        },
        "project.create": {
          "$ref": "#/$defs/MethodContract2"
        },
        "project.get": {
          "$ref": "#/$defs/MethodContract3"
        },
        "qa.list": {
          "$ref": "#/$defs/MethodContract10"
        },
        "qa.runDocument": {
          "$ref": "#/$defs/MethodContract9"
        },
        "segment.confirm": {
          "$ref": "#/$defs/MethodContract7"
        },
        "segment.list": {
          "$ref": "#/$defs/MethodContract5"
        },
        "segment.updateTarget": {
          "$ref": "#/$defs/MethodContract6"
        },
        "tm.lookupExact": {
          "$ref": "#/$defs/MethodContract8"
        }
      },
      "additionalProperties": false,
      "required": [
        "engine.initialize",
        "project.create",
        "project.get",
        "document.importDocx",
        "segment.list",
        "segment.updateTarget",
        "segment.confirm",
        "tm.lookupExact",
        "qa.runDocument",
        "qa.list",
        "document.exportDocx"
      ]
    },
    "Segment": {
      "type": "object",
      "properties": {
        "contextHash": {
          "type": "string"
        },
        "documentId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "ordinal": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sourceHash": {
          "type": "string"
        },
        "sourceText": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/SegmentState"
        },
        "structuralPath": {
          "type": "string"
        },
        "targetText": {
          "type": "string"
        },
        "updatedAtMs": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "documentId",
        "ordinal",
        "structuralPath",
        "sourceText",
        "targetText",
        "state",
        "revision",
        "sourceHash",
        "contextHash",
        "updatedAtMs"
      ]
    },
    "SegmentCounts": {
      "type": "object",
      "properties": {
        "confirmed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "draft": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "openIssues": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "untranslated": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "untranslated",
        "draft",
        "confirmed",
        "openIssues"
      ]
    },
    "SegmentListParams": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "format": "uint32",
          "default": 200,
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "documentId"
      ]
    },
    "SegmentPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Segment"
          }
        },
        "limit": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "items",
        "total",
        "offset",
        "limit"
      ]
    },
    "SegmentState": {
      "type": "string",
      "enum": [
        "untranslated",
        "draft",
        "confirmed"
      ]
    },
    "TmEntry": {
      "type": "object",
      "properties": {
        "confirmedAtMs": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "memoryId": {
          "type": "string"
        },
        "originDocumentId": {
          "type": "string"
        },
        "originProjectId": {
          "type": "string"
        },
        "originSegmentId": {
          "type": "string"
        },
        "sourceHash": {
          "type": "string"
        },
        "sourceText": {
          "type": "string"
        },
        "targetText": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "memoryId",
        "sourceText",
        "targetText",
        "sourceHash",
        "originProjectId",
        "originDocumentId",
        "originSegmentId",
        "confirmedAtMs"
      ]
    },
    "UpdateTargetParams": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "segmentId": {
          "type": "string"
        },
        "targetText": {
          "type": "string"
        }
      },
      "required": [
        "segmentId",
        "targetText",
        "expectedRevision"
      ]
    }
  }
}