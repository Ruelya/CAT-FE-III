{
  "name": "@translunar/plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm build:example",
    "build:example": "node scripts/build-hello-srt.mjs",
    "pretest": "pnpm build:example",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.example.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "esbuild": "0.27.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
