{
  "manifestVersion": 2,
  "id": "example.connector-openai-compatible",
  "displayName": "OpenAI-compatible Loopback Connector",
  "version": "1.0.0",
  "hostApi": {
    "min": 1,
    "max": 1
  },
  "runtime": {
    "tier": "declarative",
    "runtimeVersion": 1,
    "entry": {
      "kind": "manifest"
    }
  },
  "contributions": [
    {
      "kind": "engineConnector",
      "descriptorVersion": 1,
      "id": "example.connector-openai-compatible.chat",
      "version": "1.0.0",
      "displayName": "OpenAI-compatible Loopback",
      "protocol": "translunar.engineConnector.v1",
      "contractVersion": 1,
      "operations": [
        "validateConfig",
        "test",
        "generate"
      ],
      "configSchemaVersion": 1,
      "configSchema": {
        "schemaVersion": 1,
        "fields": [
          {
            "key": "maxOutputTokens",
            "label": "Maximum output tokens",
            "fieldType": "integer",
            "required": false,
            "defaultValue": 1024,
            "min": 1,
            "max": 4096
          },
          {
            "key": "responseMode",
            "label": "Response mode",
            "fieldType": "select",
            "required": true,
            "defaultValue": "stream",
            "options": [
              {
                "value": "stream",
                "label": "Streaming"
              },
              {
                "value": "json",
                "label": "Single response"
              }
            ]
          }
        ]
      },
      "limits": {
        "maxConfigBytes": 4096,
        "maxMessages": 64,
        "maxMessageBytes": 32768,
        "maxSourceTextBytes": 262144,
        "maxOutputBytes": 1048576,
        "maxEvents": 2048,
        "maxModels": 64,
        "maxModelIdBytes": 128,
        "maxDeadlineMs": 30000
      },
      "declarative": {
        "definitionVersion": 1,
        "endpoint": {
          "destinationOrigin": "http://127.0.0.1:43123",
          "urlTemplate": "http://127.0.0.1:43123/v1/chat/completions",
          "method": "POST"
        },
        "fixedHeaders": [
          {
            "name": "x-client",
            "value": "translunar-tier1-fixture"
          }
        ],
        "authentication": {
          "kind": "bearer"
        },
        "request": {
          "fixedBody": {},
          "modelPath": [
            "model"
          ],
          "messagesPath": [
            "messages"
          ],
          "sourceTextPath": [
            "source_text"
          ],
          "sourceLocalePath": [
            "source_locale"
          ],
          "targetLocalePath": [
            "target_locale"
          ],
          "streamPath": [
            "stream"
          ]
        },
        "response": {
          "kind": "serverSentEvents",
          "deltaPath": [
            "choices",
            "0",
            "delta",
            "content"
          ],
          "finishReasonPath": [
            "choices",
            "0",
            "finish_reason"
          ],
          "usage": {
            "inputTokensPath": [
              "usage",
              "prompt_tokens"
            ],
            "outputTokensPath": [
              "usage",
              "completion_tokens"
            ],
            "totalTokensPath": [
              "usage",
              "total_tokens"
            ]
          },
          "doneMarker": "[DONE]",
          "maxLineBytes": 65536
        },
        "failures": [
          {
            "status": 400,
            "code": "protocol",
            "retryable": false
          },
          {
            "status": 401,
            "code": "authentication",
            "retryable": false
          },
          {
            "status": 429,
            "code": "rateLimit",
            "retryable": true
          },
          {
            "status": 500,
            "code": "unavailable",
            "retryable": true
          },
          {
            "status": 503,
            "code": "unavailable",
            "retryable": true
          }
        ]
      }
    }
  ],
  "permissions": [],
  "capabilities": [
    {
      "capabilityId": "engine.connector",
      "required": true,
      "scope": {
        "kind": "operations",
        "operations": [
          "validateConfig",
          "test",
          "generate"
        ]
      },
      "contributionId": "example.connector-openai-compatible.chat"
    },
    {
      "capabilityId": "network.connect",
      "required": true,
      "scope": {
        "kind": "network",
        "origins": [
          "http://127.0.0.1:43123"
        ]
      },
      "contributionId": "example.connector-openai-compatible.chat"
    }
  ],
  "distribution": {
    "publisher": "Translunar",
    "license": "MIT",
    "homepage": "https://github.com/Ruelya/translunar-cat"
  }
}
