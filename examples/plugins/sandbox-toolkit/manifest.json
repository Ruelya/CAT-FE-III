{
  "manifestVersion": 2,
  "id": "example.sandbox-toolkit",
  "displayName": "Sandbox Toolkit",
  "version": "0.1.0",
  "hostApi": {
    "min": 1,
    "max": 1
  },
  "runtime": {
    "tier": "sandbox",
    "runtimeVersion": 1,
    "entry": {
      "kind": "javascript",
      "path": "entry.mjs"
    }
  },
  "contributions": [
    {
      "kind": "filter",
      "descriptorVersion": 1,
      "id": "example.sandbox-toolkit.echo",
      "version": "0.1.0",
      "displayName": "Sandbox Echo",
      "extensions": ["sandbox-echo"],
      "capabilities": {
        "import": false,
        "export": false,
        "validate": true,
        "inlineTags": false,
        "notes": false,
        "degradationReport": false
      }
    },
    {
      "kind": "aiAction",
      "descriptorVersion": 1,
      "id": "example.sandbox-toolkit.terminology",
      "version": "0.1.0",
      "displayName": "Terminology Rewrite",
      "label": "Rewrite terminology",
      "placement": "editorSelection",
      "input": {
        "type": "object"
      },
      "operationProtocolVersion": 1,
      "inputFields": ["selectionText", "sourceLocale", "targetLocale"],
      "resultModes": ["replaceSelection"],
      "configSchemaVersion": 1,
      "configSchema": {
        "schemaVersion": 1,
        "fields": []
      },
      "limits": {
        "maxInputBytes": 262144,
        "maxOutputBytes": 262144,
        "maxTags": 256,
        "maxDeadlineMs": 10000
      }
    },
    {
      "kind": "uiPanel",
      "descriptorVersion": 1,
      "id": "example.sandbox-toolkit.panel",
      "version": "0.1.0",
      "displayName": "Sandbox Toolkit Panel",
      "label": "Terminology",
      "placement": "editorSidebar",
      "surface": "panel/index.html",
      "bridgeVersion": 1,
      "contractVersion": 1,
      "methods": ["panelContext"],
      "order": 10
    }
  ],
  "permissions": [],
  "capabilities": [
    {
      "capabilityId": "file.read",
      "required": true,
      "scope": {
        "kind": "file",
        "areas": ["source"]
      },
      "contributionId": "example.sandbox-toolkit.echo"
    },
    {
      "capabilityId": "diagnostics.read",
      "required": true,
      "scope": {
        "kind": "diagnostics",
        "categories": ["summary"]
      },
      "contributionId": "example.sandbox-toolkit.echo"
    },
    {
      "capabilityId": "ai.action",
      "required": true,
      "scope": {
        "kind": "contributions",
        "contributionIds": ["example.sandbox-toolkit.terminology"]
      },
      "contributionId": "example.sandbox-toolkit.terminology"
    },
    {
      "capabilityId": "ui.panel",
      "required": true,
      "scope": {
        "kind": "contributions",
        "contributionIds": ["example.sandbox-toolkit.panel"]
      },
      "contributionId": "example.sandbox-toolkit.panel"
    }
  ],
  "distribution": {
    "publisher": "Translunar",
    "license": "MIT",
    "homepage": "https://github.com/Ruelya/translunar-cat"
  }
}
