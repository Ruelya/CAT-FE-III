{
  "manifestVersion": 2,
  "id": "example.tier1-toolkit",
  "displayName": "Tier 1 Toolkit",
  "version": "1.0.0",
  "hostApi": {
    "min": 1,
    "max": 1
  },
  "runtime": {
    "tier": "declarative",
    "runtimeVersion": 1,
    "entry": {
      "kind": "manifest"
    }
  },
  "contributions": [
    {
      "kind": "filter",
      "descriptorVersion": 1,
      "id": "example.tier1.lines",
      "version": "1.0.0",
      "displayName": "CAT line records",
      "extensions": ["catlines"],
      "capabilities": {
        "import": true,
        "export": true,
        "validate": true,
        "inlineTags": false,
        "notes": false,
        "degradationReport": false
      },
      "declarative": {
        "definitionVersion": 1,
        "encoding": "utf8",
        "probeHeaderPattern": "(?m)^CAT1\\r?$",
        "unitPattern": "(?m)^(?<id>[A-Za-z0-9_-]+)\\|(?<source>[^\\r\\n]+)$",
        "limits": {
          "maxSourceBytes": 1048576,
          "maxOutputBytes": 1048576,
          "maxUnits": 10000,
          "maxUnitBytes": 65536,
          "maxCaptureBytes": 256,
          "probeHeaderBytes": 4096
        }
      }
    },
    {
      "kind": "qaRule",
      "descriptorVersion": 1,
      "id": "example.tier1.qa",
      "version": "1.0.0",
      "displayName": "Editorial placeholders",
      "ruleType": "regexPack",
      "severity": "warning",
      "definition": {},
      "declarative": {
        "definitionVersion": 1,
        "rules": [
          {
            "id": "todo-placeholder",
            "label": "TODO placeholder",
            "field": "target",
            "pattern": "\\bTODO\\b",
            "severity": "warning",
            "message": "Target contains a TODO placeholder.",
            "replacementHint": "Replace TODO with the final translation."
          }
        ]
      }
    },
    {
      "kind": "pipelineStep",
      "descriptorVersion": 1,
      "id": "example.tier1.normalize",
      "version": "1.0.0",
      "displayName": "Normalize delivery metadata",
      "input": "json",
      "output": "json",
      "configSchemaVersion": 1,
      "resumable": false,
      "cancellable": true,
      "declarative": {
        "definitionVersion": 1,
        "input": "json",
        "output": "json",
        "operations": [
          {
            "operation": "assert",
            "path": ["schemaVersion"],
            "equals": 1
          },
          {
            "operation": "set",
            "path": ["status"],
            "value": "ready"
          },
          {
            "operation": "regexReplace",
            "path": ["title"],
            "pattern": "\\s+",
            "replacement": " ",
            "maxReplacements": 100
          }
        ],
        "maxInputBytes": 1048576,
        "maxOutputBytes": 1048576
      }
    }
  ],
  "permissions": [],
  "capabilities": [
    {
      "capabilityId": "file.read",
      "scope": {
        "kind": "file",
        "areas": ["source"]
      },
      "contributionId": "example.tier1.lines"
    },
    {
      "capabilityId": "file.write",
      "scope": {
        "kind": "file",
        "areas": ["output"]
      },
      "contributionId": "example.tier1.lines"
    },
    {
      "capabilityId": "qa.register",
      "scope": {
        "kind": "contributions",
        "contributionIds": ["example.tier1.qa"]
      },
      "contributionId": "example.tier1.qa"
    },
    {
      "capabilityId": "pipeline.register",
      "scope": {
        "kind": "contributions",
        "contributionIds": ["example.tier1.normalize"]
      },
      "contributionId": "example.tier1.normalize"
    }
  ],
  "distribution": {
    "publisher": "Translunar",
    "license": "MIT",
    "homepage": "https://github.com/Ruelya/translunar-cat"
  }
}
