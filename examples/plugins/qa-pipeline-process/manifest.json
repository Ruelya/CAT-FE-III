{
  "manifestVersion": 2,
  "id": "example.qa-pipeline-process",
  "displayName": "QA and resumable pipeline example",
  "version": "1.0.0",
  "hostApi": {
    "min": 1,
    "max": 1
  },
  "runtime": {
    "tier": "process",
    "runtimeVersion": 1,
    "protocolVersion": 1,
    "entry": {
      "kind": "node",
      "path": "bin/qa-pipeline-process.mjs"
    }
  },
  "contributions": [
    {
      "kind": "qaRule",
      "descriptorVersion": 1,
      "operationProtocolVersion": 1,
      "id": "example.qa.brand-compliance",
      "version": "1.0.0",
      "displayName": "Brand compliance",
      "ruleType": "mechanical",
      "severity": "warning",
      "definition": {},
      "ruleKind": "mechanical",
      "categories": [
        "custom",
        "terminology"
      ],
      "configSchemaVersion": 1,
      "configSchema": {
        "schemaVersion": 1,
        "fields": [
          {
            "key": "brand",
            "label": "Required brand spelling",
            "fieldType": "text",
            "required": true
          }
        ]
      },
      "config": {
        "brand": "ACME"
      },
      "limits": {
        "maxFindings": 64,
        "maxMessageBytes": 1024,
        "maxEvidenceItems": 32,
        "maxRelatedSegmentIds": 16,
        "maxDeadlineMs": 2000
      }
    },
    {
      "kind": "pipelineStep",
      "descriptorVersion": 1,
      "operationProtocolVersion": 1,
      "id": "example.pipeline.batch-normalize",
      "version": "1.0.0",
      "displayName": "Batch normalize",
      "input": "json",
      "output": "json",
      "configSchemaVersion": 1,
      "configSchema": {
        "schemaVersion": 1,
        "fields": [
          {
            "key": "batchSize",
            "label": "Batch size",
            "fieldType": "integer",
            "required": true,
            "min": 1,
            "max": 100
          }
        ]
      },
      "resumable": true,
      "cancellable": true,
      "checkpointSchemaVersion": 1,
      "limits": {
        "maxInputBytes": 1048576,
        "maxOutputBytes": 1048576,
        "maxConfigBytes": 65536,
        "maxCheckpointBytes": 1048576,
        "maxDeadlineMs": 30000
      }
    }
  ],
  "permissions": [],
  "capabilities": [
    {
      "capabilityId": "qa.register",
      "scope": {
        "kind": "contributions",
        "contributionIds": [
          "example.qa.brand-compliance"
        ]
      },
      "contributionId": "example.qa.brand-compliance"
    },
    {
      "capabilityId": "pipeline.register",
      "scope": {
        "kind": "contributions",
        "contributionIds": [
          "example.pipeline.batch-normalize"
        ]
      },
      "contributionId": "example.pipeline.batch-normalize"
    }
  ],
  "distribution": {
    "publisher": "Translunar",
    "license": "MIT",
    "homepage": "https://github.com/Ruelya/translunar-cat"
  }
}
