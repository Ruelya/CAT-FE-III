<?xml version="1.0" encoding="UTF-8"?><xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:sdl="urn:sdl"><file original="guide.docx" source-language="en-US" target-language="zh-CN" datatype="x-docx"><body><trans-unit id="u0"><source>TL-900 Portable Power Station User Guide</source></trans-unit><trans-unit id="u1"><source>Read all safety instructions before operating the <g id="1">TL-900 power station</g>.</source></trans-unit><trans-unit id="u2"><source>The battery capacity is 1,024 Wh and the rated output is 1,500 W.</source></trans-unit><trans-unit id="u3"><source>Do not expose the device to temperatures above 45 C.</source></trans-unit><trans-unit id="u4"><source>Press and hold the power button for 3 seconds to turn the unit on.</source></trans-unit><trans-unit id="u5"><source>Do not expose the device to temperatures above 45 C.</source></trans-unit><trans-unit id="u6"><source>The warranty period is <g id="2">24 months</g> from the date of purchase.</source></trans-unit></body></file></xliff>
