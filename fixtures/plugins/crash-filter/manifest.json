{
  "manifestVersion": 1,
  "id": "fixture.crash-filter",
  "displayName": "Crash Filter Fixture",
  "version": "0.1.0",
  "apiVersion": 1,
  "apiVersionMin": 1,
  "tier": "process",
  "entry": {
    "kind": "node",
    "path": "bin/crash-filter.mjs"
  },
  "contributions": {
    "filters": [
      {
        "id": "fixture.crash-filter",
        "version": "0.1.0",
        "displayName": "Crash Filter Fixture",
        "extensions": ["crash"],
        "capabilities": {
          "import": true,
          "export": false,
          "validate": false,
          "inlineTags": false,
          "notes": false,
          "degradationReport": false
        }
      }
    ]
  },
  "permissions": ["file.read:source"]
}
